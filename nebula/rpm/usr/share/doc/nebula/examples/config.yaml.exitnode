pki:
  ca: /etc/nebula/ca.crt
  cert: /etc/nebula/exit.crt
  key: /etc/nebula/exit.key

static_host_map:
  "10.0.0.1": ["1.2.3.4:4242"]

lighthouse:
  am_lighthouse: false
  hosts:
    - "10.0.0.1"

tun:
  dev: nebula1
  # This node advertises that it can handle "the whole internet"
  unsafe_routes:
    - route: 0.0.0.0/0
      via: 10.0.0.254 # The Nebula IP of this node

firewall:
  conntrack:
    tcp_timeout: 12m
  
  outbound:
    - port: any
      proto: any
      host: any

  inbound:
    # You must allow traffic from your Nebula "clients" to pass through
    - port: any
      proto: any
      groups:
        - laptop_users
